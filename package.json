{
  "name": "xdev-ai",
  "displayName": "xDev AI",
  "description": "Manage AI accounts, open Claude Code, Codex, and Gemini terminals, and coordinate AI tasks in VS Code.",
  "version": "0.7.1",
  "publisher": "xdev-asia",
  "icon": "media/icon.png",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xdev-asia/vscode-ai-profiles.git"
  },
  "bugs": {
    "url": "https://github.com/xdev-asia/vscode-ai-profiles/issues"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20.3"
  },
  "categories": ["AI"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "types": "./dist/core.d.ts",
  "files": ["dist", "media", "CHANGELOG.md", "LICENSE"],
  "contributes": {
    "commands": [
      { "command": "xdevAi.chat", "title": "Open Chat", "category": "xDev AI", "icon": "$(comment-discussion)" },
      { "command": "xdevAi.addAccount", "title": "Add API Profile", "category": "xDev AI", "icon": "$(add)" },
      { "command": "xdevAi.switchAccount", "title": "Switch API Profile", "category": "xDev AI", "icon": "$(check)" },
      { "command": "xdevAi.manageAccounts", "title": "Manage API Profiles", "category": "xDev AI" },
      { "command": "xdevAi.openAccountChat", "title": "Open API Chat with this Profile", "category": "xDev AI", "icon": "$(comment-discussion)" },
      { "command": "xdevAi.squad.open", "title": "Open Squad", "category": "xDev AI", "icon": "$(organization)" },
      { "command": "xdevAi.squad.workflow", "title": "Open SDLC Workflow", "category": "xDev AI" },
      { "command": "xdevAi.squad.customizations", "title": "Manage Skills and Tools", "category": "xDev AI" },
      { "command": "xdevAi.squad.memory", "title": "Open Squad Memory", "category": "xDev AI" },
      { "command": "xdevAi.squad.syncSkills", "title": "Sync Squad Skills and Memory", "category": "xDev AI" },
      { "command": "xdevAi.manageMcp", "title": "Manage MCP", "category": "xDev AI", "icon": "$(plug)" },
      { "command": "xdevAi.manageTerminalAccounts", "title": "Open AI Accounts Sidebar", "category": "xDev AI", "icon": "$(account)" },
      { "command": "xdevAi.addAiAccount", "title": "Add AI Account", "category": "xDev AI", "icon": "$(add)" },
      { "command": "xdevAi.openTerminal", "title": "Open AI Terminal", "category": "xDev AI", "icon": "$(terminal)" },
      { "command": "xdevAi.openTerminalBypass", "title": "Open AI Terminal with Bypass Permissions", "category": "xDev AI" },
      { "command": "xdevAi.checkUsage", "title": "Check AI Usage", "category": "xDev AI", "icon": "$(graph)" },
      { "command": "xdevAi.refreshUsage", "title": "Refresh Account Quota", "category": "xDev AI" },
      { "command": "xdevAi.signInTerminal", "title": "Sign In to Terminal Account", "category": "xDev AI" },
      { "command": "xdevAi.renameTerminalAccount", "title": "Rename Terminal Account", "category": "xDev AI" },
      { "command": "xdevAi.removeTerminalAccount", "title": "Delete Terminal Account", "category": "xDev AI", "icon": "$(trash)" },
      { "command": "xdevAi.removeAccount", "title": "Delete API Profile", "category": "xDev AI", "icon": "$(trash)" }
    ],
    "viewsContainers": {
      "activitybar": [
        { "id": "xdev-ai", "title": "xDev AI", "icon": "$(account)" }
      ],
      "panel": [
        { "id": "xdev-ai-squad", "title": "xDev Squad", "icon": "$(organization)" }
      ]
    },
    "views": {
      "xdev-ai": [
        { "id": "xdevAi.claude.accounts", "name": "Terminal Accounts" },
        { "id": "xdevAi.apiAccounts", "name": "API Profiles" }
      ],
      "xdev-ai-squad": [
        { "id": "xdevAi.squad", "name": "Squad", "type": "webview" }
      ]
    },
    "viewsWelcome": [
      { "view": "xdevAi.claude.accounts", "contents": "Sign in to Claude Code, Codex, or Gemini CLI. Each account opens in its own terminal.\n[Add AI Account](command:xdevAi.addAiAccount)" },
      { "view": "xdevAi.apiAccounts", "contents": "Add a provider API profile for xDev Chat and Squad.\n[Add API Profile](command:xdevAi.addAccount)" }
    ],
    "menus": {
      "view/title": [
        { "command": "xdevAi.manageTerminalAccounts", "when": "view == terminal", "group": "navigation@20" },
        { "command": "xdevAi.openTerminal", "when": "view == terminal", "group": "navigation@21" },
        { "command": "xdevAi.squad.open", "when": "view == terminal", "group": "navigation@22" },
        { "command": "xdevAi.addAiAccount", "when": "view == xdevAi.claude.accounts || view == xdevAi.squad", "group": "navigation@1" },
        { "command": "xdevAi.checkUsage", "when": "view == xdevAi.claude.accounts", "group": "navigation@2" },
        { "command": "xdevAi.squad.open", "when": "view == xdevAi.claude.accounts", "group": "navigation@3" },
        { "command": "xdevAi.squad.workflow", "when": "view == xdevAi.claude.accounts", "group": "1_workspace@1" },
        { "command": "xdevAi.squad.customizations", "when": "view == xdevAi.claude.accounts", "group": "1_workspace@2" },
        { "command": "xdevAi.manageMcp", "when": "view == xdevAi.claude.accounts || view == xdevAi.squad", "group": "1_workspace@3" },
        { "command": "xdevAi.addAccount", "when": "view == xdevAi.apiAccounts", "group": "navigation@1" },
        { "command": "xdevAi.chat", "when": "view == xdevAi.apiAccounts", "group": "navigation@2" },
        { "command": "xdevAi.manageTerminalAccounts", "when": "view == xdevAi.squad", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "xdevAi.openTerminal", "when": "view == xdevAi.claude.accounts && viewItem == aiTerminalAccount", "group": "inline@1" },
        { "command": "xdevAi.checkUsage", "when": "view == xdevAi.claude.accounts && viewItem == aiTerminalAccount", "group": "inline@2" },
        { "command": "xdevAi.removeTerminalAccount", "when": "view == xdevAi.claude.accounts && viewItem == aiTerminalAccount", "group": "inline@3" },
        { "command": "xdevAi.signInTerminal", "when": "view == xdevAi.claude.accounts && viewItem == aiTerminalAccount", "group": "1_account@1" },
        { "command": "xdevAi.renameTerminalAccount", "when": "view == xdevAi.claude.accounts && viewItem == aiTerminalAccount", "group": "1_account@2" },
        { "command": "xdevAi.removeTerminalAccount", "when": "view == xdevAi.claude.accounts && viewItem == aiTerminalAccount", "group": "1_account@3" },
        { "command": "xdevAi.openTerminalBypass", "when": "view == xdevAi.claude.accounts && viewItem == aiTerminalAccount && isWorkspaceTrusted", "group": "1_account@4" },
        { "command": "xdevAi.openAccountChat", "when": "view == xdevAi.apiAccounts && viewItem == aiApiAccount", "group": "inline@1" },
        { "command": "xdevAi.removeAccount", "when": "view == xdevAi.apiAccounts && viewItem == aiApiAccount", "group": "inline@2" },
        { "command": "xdevAi.switchAccount", "when": "view == xdevAi.apiAccounts && viewItem == aiApiAccount", "group": "1_account@1" },
        { "command": "xdevAi.manageAccounts", "when": "view == xdevAi.apiAccounts && viewItem == aiApiAccount", "group": "1_account@2" },
        { "command": "xdevAi.removeAccount", "when": "view == xdevAi.apiAccounts && viewItem == aiApiAccount", "group": "1_account@3" }
      ],
      "commandPalette": [
        { "command": "xdevAi.openAccountChat", "when": "false" }
      ]
    },
    "terminal": {
      "profiles": [
        { "id": "xdevAi.terminal", "title": "xDev AI: Choose Account", "icon": "terminal" },
        { "id": "xdevAi.terminal.bypass", "title": "xDev AI: Bypass Permissions", "icon": "warning" },
        { "id": "xdevAi.claude.terminal", "title": "xDev AI: Claude Code", "icon": "terminal" }
      ]
    },
    "mcpServerDefinitionProviders": [
      { "id": "xdevAi.mcp", "label": "xDev AI" }
    ],
    "languageModelTools": [
      {
        "name": "xdev_squad_ask",
        "displayName": "Ask xDev Squad",
        "toolReferenceName": "xdevSquadAsk",
        "canBeReferencedInPrompt": true,
        "userDescription": "Send a message to the assigned xDev Squad API profile.",
        "modelDescription": "Use when the user asks to delegate a request to xDev Squad. By default asks Lead for an answer or draft plan. Prefix the message with @Implement, @Review, or @Tests to address that role directly. Pass the user's requested text and context they explicitly included for Squad. This can contact the assigned API text model and cannot edit files or run tests. Present any pending plan with its roles, profiles, and briefs. Wait for a later user request before calling the plan tool to run it.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": { "type": "string", "description": "The request for the role, with an optional @Role prefix.", "minLength": 1, "maxLength": 8000 }
          },
          "required": ["message"],
          "additionalProperties": false
        }
      },
      {
        "name": "xdev_squad_plan",
        "displayName": "Manage xDev Squad Plan",
        "toolReferenceName": "xdevSquadPlan",
        "canBeReferencedInPrompt": true,
        "userDescription": "View, run, or discard the current xDev Squad plan.",
        "modelDescription": "View the current xDev Squad plan, or run or discard the specified plan when the user expressly requests that action after seeing the plan. Use the exact plan ID returned by xDev Squad. Run requests require a separate confirmation in VS Code. If the user declines or cancels, do not retry. Show the returned results grouped by role.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["view", "run", "discard"] },
            "planId": { "type": "string", "description": "The exact ID from the pending plan. Required for run and discard." }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      },
      {
        "name": "xdev_sdlc",
        "displayName": "xDev SDLC Workflow",
        "toolReferenceName": "xdevSdlc",
        "canBeReferencedInPrompt": true,
        "userDescription": "See the current SDLC stage or draft its result with the assigned xDev Squad API profile.",
        "modelDescription": "Use view to read progress of the xDev SDLC workflow. When the user asks to draft the current stage, first obtain its workflow ID and zero-based step using view, then call draft with those values. Drafting sends the project brief, approved results, and enabled skills to the assigned text API. It cannot approve a stage, edit files, run tests, or deploy. The user reviews and approves results under xDev Squad Workflow.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": { "type": "string", "enum": ["view", "draft"] },
            "workflowId": { "type": "string", "description": "The exact workflow ID from view. Required for draft." },
            "step": { "type": "integer", "minimum": 0, "maximum": 4, "description": "The current zero-based step from view. Required for draft." }
          },
          "required": ["action"],
          "additionalProperties": false
        }
      }
    ],
    "configuration": {
      "title": "xDev AI",
      "properties": {
        "xdevAi.claudeExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to Claude Code on the machine hosting the workspace. Leave empty to detect a native installation or search PATH."
        },
        "xdevAi.codexExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to Codex on the workspace host. Leave empty to detect the installation automatically."
        },
        "xdevAi.geminiExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to Gemini CLI on the workspace host. Leave empty to detect the installation automatically."
        },
        "xdevAi.squad.workerAllowedCommands": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["npm test", "npm run build", "npm run lint"],
          "markdownDescription": "Command prefixes that headless Claude Code workers (Implement and Tests) may run without asking, for example `npm test` or `dotnet test`. Other shell commands are denied and reported in the chat. Read-only git commands are always allowed."
        },
        "xdevAi.squad.workerBudgetUsd": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 50,
          "markdownDescription": "Spending cap in USD for each headless worker run (`--max-budget-usd`). `0` turns the cap off."
        },
        "xdevAi.squad.workerModels": {
          "type": "object",
          "default": {},
          "properties": {
            "Lead": { "type": "string" },
            "Implement": { "type": "string" },
            "Review": { "type": "string" },
            "Tests": { "type": "string" }
          },
          "additionalProperties": false,
          "markdownDescription": "Claude Code model per Squad role, for example `{ \"Implement\": \"sonnet\", \"Review\": \"haiku\" }`. Empty uses the account default. A cheaper model for Review and Tests saves usage."
        },
        "xdevAi.squad.workerTimeoutMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 120,
          "description": "Stop a headless worker that runs longer than this many minutes."
        },
        "xdevAi.squad.syncSkillsToProfiles": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Copy enabled Squad skills into each Claude Code account as `xdev-*` user skills, so workers load them on demand. Skills you installed yourself are never changed."
        },
        "xdevAi.squad.syncFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder used by **Sync with folder** to share skills and Squad memory, usually a clone of your team docs repository. Relative paths start at the first workspace folder."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle-mcp.cjs",
    "test": "npm run build && node --test",
    "vscode:prepublish": "npm run build",
    "prepack": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
